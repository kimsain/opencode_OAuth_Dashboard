{
  // dataMode options: "oauth" (default), "api", "sample"
  // Precedence: oauth > api > sample
  "dataMode": "oauth",
  "enableSampleFallback": true,
  "usageUrl": "https://api.example.com/v1/usage",
  "method": "GET",
  "headers": {
    "Authorization": "Bearer YOUR_ACCESS_TOKEN"
  },
  "timeoutMs": 8000,
  "refreshIntervalMs": 60000
}
